# Copy to .env and fill in the values. Never commit the real .env file.
# Use the same user, password and database as the root .env (docker compose).
DATABASE_URL=postgresql+psycopg://<user>:<password>@localhost:5432/<database>
# Optional: defaults to the same server with a "<database>_test" database
TEST_DATABASE_URL=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=["http://localhost:5173"]
TIMEZONE=America/Guayaquil

BUSINESS_NAME=La Navaja Barbería
# SMTP for customer emails. Leave SMTP_HOST empty to only log emails.
# Local testing with Mailpit: SMTP_HOST=localhost SMTP_PORT=1025 SMTP_STARTTLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true
# EMAIL_FROM=reservas@tu-dominio.com
